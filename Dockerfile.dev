# Entorno de desarrollo: Next.js 16 + pnpm, con hot reload contra el código montado.
FROM node:22-alpine

# corepack resuelve la versión de pnpm desde el campo "packageManager" del package.json.
RUN corepack enable

WORKDIR /app

# Las deps se instalan en la imagen; el bind mount del compose no las pisa
# porque /app/node_modules queda como volumen aparte.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 3000

CMD ["pnpm", "dev", "--hostname", "0.0.0.0", "--port", "3000"]
